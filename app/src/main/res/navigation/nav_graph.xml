<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.lilbro.picobotella.ui.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_home_to_retos"
            app:destination="@id/retosFragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/retosFragment"
        android:name="com.lilbro.picobotella.ui.retos.RetosFragment"
        android:label="RetosFragment">
        <action
            android:id="@+id/action_retos_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

</navigation>